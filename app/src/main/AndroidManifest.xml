<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions - Apex Spec Compliant -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:name=".QuantraVisionApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuantraVision"
        tools:targetApi="31">

        <!-- Main Activity - App Entry Point -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuantraVision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Standalone Onboarding Activity (legacy/standalone use) -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.QuantraVision.Splash" />

        <!-- Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.QuantraVision" />

        <!-- Subscription Activity -->
        <activity
            android:name=".ui.SubscriptionActivity"
            android:exported="false"
            android:label="@string/subscription_title"
            android:theme="@style/Theme.QuantraVision" />

        <!-- About Activity -->
        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:theme="@style/Theme.QuantraVision" />

        <!-- Screen Capture Service -->
        <service
            android:name=".services.ScreenCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Q Toggle Service -->
        <service
            android:name=".services.QToggleService"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
